# Database PostgreSQL
POSTGRES_USER=tutorhub
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=tutorhub
POSTGRES_PORT=5432

# JWT Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_here
JWT_ISSUER=TutorHubAPI
JWT_AUDIENCE=TutorHubClient
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# VNPay Sandbox Gateway
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret_key
VNPAY_RETURN_URL=http://localhost:5000/api/v1/payments/vnpay/return

# AWS S3 Cloud Storage
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_SERVICE_URL=
AWS_CLOUDFRONT_DOMAIN=
