# ============================================================
# TutorHub backend — environment template
#
#   cp .env.example .env      (then fill in real values)
#
# Naming rules (important):
#   * POSTGRES_* keep their bare names: they are consumed by the
#     postgres container image and by docker-compose interpolation.
#   * Every .NET option uses its configuration path with `__`
#     instead of `:`  (Jwt:Secret  ->  Jwt__Secret).
#     Both the Development .env loader and docker-compose expect
#     this form; bare names like JWT_SECRET do NOT bind.
#
# Generate strong secrets with:
#     openssl rand -base64 48
#
# The API refuses to start while any value below still contains a
# placeholder (your_ / change_me / placeholder / super_secret).
# ============================================================

# --- PostgreSQL (bare names: image + compose interpolation) ---
POSTGRES_USER=tutorhub
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=tutorhub
POSTGRES_PORT=5432

# --- Application database (Npgsql connection string) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=tutorhub;Username=tutorhub;Password=change_me_postgres_password

# --- JWT (Secret must be at least 32 characters) ---
Jwt__Secret=change_me_generate_with_openssl_rand_base64_48
Jwt__Issuer=TutorHubAPI
Jwt__Audience=TutorHubClient
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# --- Refresh token hashing pepper (at least 32 characters) ---
RefreshToken__Pepper=change_me_generate_with_openssl_rand_base64_48

# --- VNPay gateway (sandbox defaults) ---
VnPay__TmnCode=TUTORHUB
VnPay__HashSecret=change_me_vnpay_hash_secret
VnPay__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VnPay__ReturnUrl=http://localhost:5129/api/v1/payments/vnpay/return

# --- Cloudflare R2 object storage ---
CloudflareR2__AccountId=change_me_cloudflare_account_id
CloudflareR2__BucketName=tutorhub-media
CloudflareR2__AccessKeyId=change_me_r2_access_key_id
CloudflareR2__SecretAccessKey=change_me_r2_secret_access_key

# --- Amazon SES (production email; Development falls back to log-only) ---
# Leaving Ses__FromAddress empty keeps the log-only sender in Development and
# stops startup in any other environment.
Ses__Region=ap-southeast-1
Ses__FromAddress=change_me_verified_sender_address
Ses__FromDisplayName=TutorHub
# Optional SES configuration set (empty = not used).
Ses__ConfigurationSetName=

# --- AWS credentials used by the SES client ---
# Optional: leave both blank to authenticate through an instance/task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
