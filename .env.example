# Database PostgreSQL
POSTGRES_USER=tutorhub
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=tutorhub
POSTGRES_PORT=5432

# JWT Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_here
JWT_ISSUER=TutorHubAPI
JWT_AUDIENCE=TutorHubClient
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# VNPay Sandbox Gateway
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret_key
VNPAY_RETURN_URL=http://localhost:5000/api/v1/payments/vnpay/return

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_BUCKET_NAME=tutorhub-media
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
