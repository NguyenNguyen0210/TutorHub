{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Enrichers.Environment"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName"]
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Redis": {
    "Enabled": false,
    "InstanceName": "tutorhub:",
    "Features": {
      "OAuth": true,
      "SignalR": true,
      "Cache": true,
      "CronLock": true
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "TutorHubAPI",
    "Audience": "TutorHubClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "VnPay": {
    "TmnCode": "",
    "HashSecret": "",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "",
    "Version": "2.1.0",
    "Command": "pay",
    "CurrCode": "VND",
    "Locale": "vn",
    "OrderType": "other",
    "PaymentTimeoutMinutes": 15
  },
  "CloudflareR2": {
    "AccountId": "",
    "BucketName": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "PresignedUrlExpirationMinutes": 15
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "ExternalAuth": {
    "RedirectUri": "",
    "StateLifetimeMinutes": 10,
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": "openid email profile"
    }
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": false,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromDisplayName": "TutorHub"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
