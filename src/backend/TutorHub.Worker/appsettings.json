{
  // Trimmed copy of TutorHub.Api/appsettings.json: only what AddInfrastructure
  // binds (plus Serilog/Database/BackgroundJobs, read by Program.cs). Every key
  // dropped here (Logging, AllowedHosts, Auth, VnPay display fields, R2 expiry,
  // ExternalAuth, Jwt expirations) merely restated an in-code default, so the
  // bound options are identical. Kept in sync with Api appsettings.json.
  // Serilog owns all logging: console compact-JSON always; the Seq sink is
  // added in code only when Seq:ServerUrl is set, so an empty URL means
  // console-only.
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Enrichers.Environment"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  // Phase 3 WP8: the worker owns the jobs; the api sets this to false
  // when the worker runs so jobs never double-run.
  "BackgroundJobs": {
    "Enabled": true
  },
  "Redis": {
    "Enabled": false,
    "InstanceName": "tutorhub:",
    "Features": {
      "OAuth": true,
      "SignalR": true,
      "Cache": true,
      "CronLock": true,
      "RateLimit": true,
      "RevokeCheck": true
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "TutorHubAPI",
    "Audience": "TutorHubClient"
  },
  "VnPay": {
    "TmnCode": "",
    "HashSecret": "",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": ""
  },
  "CloudflareR2": {
    "AccountId": "",
    "BucketName": "",
    "AccessKeyId": "",
    "SecretAccessKey": ""
  },
  "Ses": {
    "Region": "",
    "FromAddress": "",
    "FromDisplayName": "TutorHub"
  }
}
