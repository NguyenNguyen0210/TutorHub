{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Serilog owns all logging (same shape as TutorHub.Api): console
  // compact-JSON always; the Seq sink is added in code only when
  // Seq:ServerUrl is set, so an empty URL means console-only.
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Enrichers.Environment"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  // Phase 3 WP8: the worker owns the jobs; the api sets this to false
  // when the worker runs so jobs never double-run.
  "BackgroundJobs": {
    "Enabled": true
  },
  "Redis": {
    "Enabled": false,
    "InstanceName": "tutorhub:",
    "Features": {
      "OAuth": true,
      "SignalR": true,
      "Cache": true,
      "CronLock": true,
      "RateLimit": true,
      "RevokeCheck": true
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "TutorHubAPI",
    "Audience": "TutorHubClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "VnPay": {
    "TmnCode": "",
    "HashSecret": "",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "",
    "Version": "2.1.0",
    "Command": "pay",
    "CurrCode": "VND",
    "Locale": "vn",
    "OrderType": "other",
    "PaymentTimeoutMinutes": 15
  },
  "CloudflareR2": {
    "AccountId": "",
    "BucketName": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "PresignedUrlExpirationMinutes": 15
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "ExternalAuth": {
    "RedirectUri": "",
    "StateLifetimeMinutes": 10,
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": "openid email profile"
    },
    "Facebook": {
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": "email,public_profile"
    }
  },
  "Ses": {
    "Region": "",
    "FromAddress": "",
    "FromDisplayName": "TutorHub",
    "ConfigurationSetName": ""
  }
}
