# Copy to .env.production and fill all required values.
# Never commit the real .env.production file.

POSTGRES_USER=tutorhub
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tutorhub

REDIS_PASSWORD=change-me-strong-redis-password
REDIS_INSTANCE_NAME=tutorhub:

API_PORT=8080
ALLOWED_HOSTS=api.example.com
CORS_ORIGIN=https://app.example.com

JWT_SECRET=change-me-at-least-32-random-characters
JWT_ISSUER=TutorHubAPI
JWT_AUDIENCE=TutorHubClient
REFRESH_TOKEN_PEPPER=change-me-at-least-32-random-characters

VNPAY_TMNCODE=change-me
VNPAY_HASHSECRET=change-me
VNPAY_BASEURL=https://pay.vnpay.vn/vpcpay.html
VNPAY_RETURNURL=https://app.example.com/payment/return

R2_ACCOUNT_ID=change-me
CLOUDFLARE_R2_BUCKET=tutorhub
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me

# Resend SMTP. Verify the sender domain and supply a real Resend API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USESSL=true
SMTP_USERNAME=resend
# Resend API key (SMTP password); do not commit the actual value.
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@tutorhub.id.vn
SMTP_FROM_DISPLAY_NAME=TutorHub

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXTERNAL_AUTH_REDIRECTURI=https://app.example.com/auth/oauth/callback

